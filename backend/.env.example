# ── Neon PostgreSQL ──────────────────────────────────────────────────────────
# Get this from: neon.tech → your project → Connection Details → Connection string
# Format: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Read-only role for the scheme recommender (LLM-generated queries run on this)
# Create with: CREATE ROLE sih_readonly LOGIN PASSWORD '...';
#              GRANT SELECT ON schemes TO sih_readonly;
# Then paste the connection string here. If unset, falls back to DATABASE_URL.
DATABASE_READONLY_URL=postgresql://sih_readonly:xxxx@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── OpenRouter ───────────────────────────────────────────────────────────────
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxx

# Fast/cheap model: classification + SQL generation (high-volume, simple tasks)
# Stronger model: grounded explanations + chat tool-calling agent (quality + function-calling support matters here)
#
# 'openrouter/free' is OpenRouter's own auto-router: it randomly selects among
# currently-available free models while filtering for the features your
# request needs (e.g. tool calling), and falls back automatically if an
# individual free model gets rate-limited or rotated out. Good zero-cost
# default for development/demos. Free tier is rate-limited (50 req/day, or
# 1000/day once you've added at least $10 in OpenRouter credits at any point).
# Swap in a specific paid model (e.g. anthropic/claude-3-5-haiku) for
# production quality/throughput once you have credits.
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_STRONG_MODEL=openrouter/free

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# Set to 'true' if your DB host requires SSL but the URL doesn't contain neon.tech
# (auto-detected for Neon; leave unset for local Postgres)
# DATABASE_SSL=true
